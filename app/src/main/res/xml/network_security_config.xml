<?xml version="1.0" encoding="utf-8"?>
<!--
    Izinkan koneksi HTTP (tanpa S) HANYA ke IP VPS kamu.
    Android 9+ memblokir HTTP biasa secara default.
    Nanti kalau server sudah pakai domain + HTTPS, file ini bisa dihapus.
-->
<network-security-config>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">43.157.225.187</domain>
    </domain-config>
</network-security-config>